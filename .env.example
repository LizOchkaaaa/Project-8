# Reference only: the CLI reads the process environment, not this file.
# Never commit a real key. Configure these variables in your terminal or CI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Local HTTP MCP uses its own bearer token, read once when the app starts.
# Empty disables /mcp. No OAuth discovery, SSE, or stdio transport is provided.
PROJECT8_MCP_TOKEN=
# Optional comma-separated exact origins, including scheme and port; no wildcard.
PROJECT8_MCP_ALLOWED_ORIGINS=
# Runtime settings may reference only the matching scanner's variable name.
# Values stay in the server environment and are never saved in runtime JSON.
PROJECT8_CONNECTOR_GITLEAKS_TOKEN=
PROJECT8_CONNECTOR_BANDIT_TOKEN=
PROJECT8_CONNECTOR_PIP_AUDIT_TOKEN=
PROJECT8_CONNECTOR_TRIVY_TOKEN=
PROJECT8_CONNECTOR_ZAP_TOKEN=
